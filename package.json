{
  "name": "a-la-mano",
  "version": "0.1.0",
  "private": true,
  "description": "Starter template para aplicaciones SaaS multi-tenant en TypeScript.",
  "author": "Edward Valencia",
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @a-la-mano/web dev",
    "build": "pnpm --filter @a-la-mano/web build",
    "start": "pnpm --filter @a-la-mano/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @a-la-mano/db generate",
    "db:push": "pnpm --filter @a-la-mano/db push",
    "db:migrate": "pnpm --filter @a-la-mano/db migrate",
    "db:sql": "pnpm --filter @a-la-mano/db exec node apply-sql.mjs",
    "db:bootstrap": "pnpm --filter @a-la-mano/db exec node bootstrap.mjs",
    "db:seed-demo": "pnpm --filter @a-la-mano/db exec node seed-demo.mjs",
    "db:studio": "pnpm --filter @a-la-mano/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.3"
  }
}
